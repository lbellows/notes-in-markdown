{
  "name": "notes-in-markdown",
  "version": "0.4.1",
  "description": "Cross-platform markdown notes with hierarchy, tabs, and local autosave.",
  "author": {
    "name": "lbellows",
    "email": "me@lbellows.com"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "start": "npm run build && electron .",
    "start:fast": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "xvfb-run -a npm run test:e2e",
    "test:all": "npm run test && npm run test:e2e",
    "package:linux": "npm run build && npx electron-builder@latest --linux AppImage deb pacman --publish never",
    "package:win": "npm run build && npx electron-builder@latest --win nsis --publish never",
    "package:mac": "npm run build && npx electron-builder@latest --mac dmg zip --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.12",
    "@uiw/react-codemirror": "^4.25.11",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.0",
    "jsdom": "^30.0.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.mdnoteapp.desktop",
    "productName": "Notes in Markdown",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "maintainer": "me@lbellows.com",
      "category": "Utility",
      "icon": "electron/assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "icon": "electron/assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "pacman": {
      "artifactName": "${name}-${version}-linux-${arch}.${ext}",
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "at-spi2-core",
        "libcups",
        "libxcomposite",
        "libxdamage",
        "libxrandr",
        "libxkbcommon",
        "mesa",
        "xdg-utils"
      ],
      "fpm": [
        "--description",
        "Cross-platform markdown notes with hierarchy, tabs, and local autosave."
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "electron/assets/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@40.4.1": true,
    "esbuild@0.27.3": true
  }
}
